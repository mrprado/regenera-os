# Regenera OS environment (names only; never commit values).
# Local development: copy to .dev.vars. Production: `npx wrangler secret put NAME --name regenera-os` for secrets;
# non-secret vars live in deploy/cloudflare.json. The stack is Cloudflare Workers + D1 (no Supabase by design), so
# the Supabase/DATABASE_URL variables of the generic build instruction do not apply.

# App and auth
APP_BASE_URL=
SITE_BASE_URL=
APP_ENV=
OS_ALLOWLIST=
OS_PASSWORD=
TRACKER_AUTH_URL=
PORTAL_STAKEHOLDER=off
JOBS_TICK_TOKEN=
TOKEN_ENCRYPTION_KEY=
UNSUBSCRIBE_SIGNING_SECRET=
EXTENSION_TOKEN_SECRET=
SITE_WEBHOOK_SECRET=
SITE_EXPORT_TOKEN=

# AI (optional: the app works without it; AI features show as unavailable)
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=

# Google Workspace (Gmail, Calendar, Drive) and Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_API_KEY=

# Email (system notifications only)
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_EMAIL=
SEND_ALLOWED_DOMAINS=

# Prospect data
APOLLO_API_KEY=
APOLLO_MONTHLY_CREDIT_BUDGET=

# Data sources (see docs/API_INTEGRATIONS.md; each is optional)
EIA_API_KEY=
NOAA_CDO_TOKEN=
NASA_FIRMS_MAP_KEY=
ENTSOE_TOKEN=
FRED_API_KEY=
NREL_API_KEY=
COMPANIES_HOUSE_API_KEY=
GFW_API_KEY=
OPENAQ_API_KEY=
COMTRADE_API_KEY=
ERCOT_SUBSCRIPTION_KEY=
ERCOT_CLIENT_CONFIG=
PJM_API_KEY=
PROTECTED_PLANET_TOKEN=
PROTECTED_PLANET_COMMERCIAL_LICENSE=false
COPERNICUS_CLIENT_ID=
COPERNICUS_STAC_URL=
IMF_SDMX_URL=
NOMINATIM_URL=
ESRI_API_KEY=
OPENCORPORATES_API_KEY=

# E-signature (mock provider used when unset; signed-PDF upload always works)
ESIGN_PROVIDER=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DROPBOX_SIGN_API_KEY=

# Commercial and operations (optional, off by default)
STRIPE_SECRET_KEY=
SENTRY_DSN=

# Map
NEXT_PUBLIC_MAP_STYLE_URL=
