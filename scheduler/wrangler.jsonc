// Deployed separately to a (free) Cloudflare account. See scheduler/README.md.
{
  "name": "regenera-os-scheduler",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "TICK_URL": "https://regenera.bio/os/api/jobs/tick" },
  "observability": { "enabled": true }
}
